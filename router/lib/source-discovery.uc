import {source_url} from '/usr/share/gale/lib/sources.uc';
export function extract_public_links(body){let text=replace(replace(replace(body,/&amp;/g,'&'),/&#58;/g,':'),/&#x3a;/gi,':'),links=match(text,/(vless|vmess|trojan|ss|socks5|https?|hysteria2|hy2|tuic|anytls):\/\/[^[:space:]"'<>]+/g)||[],unique={};for(let item in links){let link=type(item)=='array'?item[0]:item;if(match(link,/^https?:/))continue;unique[link]=true;if(length(keys(unique))>500)die('DISCOVERY_PROFILE_LIMIT');}if(!length(keys(unique)))die('DISCOVERY_NO_PROXY_LINKS');return join('\n',keys(unique));};
export function catalog_candidates(body,store,source){let root;try{root=json(body);}catch(e){die('DISCOVERY_CATALOG_JSON_REQUIRED');}let entries=type(root)=='array'?root:root.subscriptions||root.sources||root.items;if(type(entries)!='array'||length(entries)>100)die('BAD_DISCOVERY_CATALOG');store.discovery_candidates=store.discovery_candidates||{};let added=0;
 for(let entry in entries){let url=type(entry)=='string'?entry:entry.url,name=type(entry)=='object'?entry.name:null,info;try{info=source_url(url);}catch(e){continue;}if(exists(store.sources,info.id))continue;if(!exists(store.discovery_candidates,info.id)){if(length(keys(store.discovery_candidates))>=200)die('DISCOVERY_CANDIDATE_LIMIT');store.discovery_candidates[info.id]={...info,name:type(name)=='string'?substr(name,0,100):info.host,found_at:time(),sources:[source.id],status:'proposed'};added++;}else{let c=store.discovery_candidates[info.id];if(!(source.id in c.sources)&&length(c.sources)<30)push(c.sources,source.id);}}
 return added;
};
export function public_candidates(store){return map(values(store.discovery_candidates||{}),c=>({id:c.id,name:c.name,host:c.host,found_at:c.found_at,source_count:length(c.sources),status:c.status}));};
