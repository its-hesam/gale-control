import {readfile,writefile,rename,chmod,open,stat,mkdtemp,unlink,rmdir} from 'fs';import {sha256} from 'digest';import {connect} from 'ubus';
import {load_store} from '/usr/share/gale/lib/store.uc';import {restore_catalog} from '/usr/share/gale/lib/backup.uc';import {validate_device_rules} from '/usr/share/gale/lib/network-plan.uc';import {connection_policy} from '/usr/share/gale/lib/selection.uc';
export const system_names=['network','firewall','wireless','dhcp','dropbear','uhttpd'];
export const host_key_names=['dropbear_ed25519_host_key','dropbear_rsa_host_key','dropbear_ecdsa_host_key','authorized_keys'];
export const recovery_paths=[...map(host_key_names,n=>'/etc/dropbear/'+n),...map(system_names,n=>'/etc/config/'+n),...map(['state.json','routing-draft.json','routing-active.json','network-options.json','discovery-options.json','cores.json','releases.json'],n=>'/etc/gale/'+n),...map(['active','binary','config.json','sidecars','sidecar-1.json','sidecar-2.json','binary-1','binary-2','pending'],n=>'/etc/gale/runtime/'+n),...map(['armed','draft.json','rules.nft','dns.json','tcp.json','binary-dns','binary-tcp','trial-mode','manifest.sha256'],n=>'/etc/gale/routing-test/'+n),...map(['armed','committed','dns.json','tcp.json','rules.nft','network-options.json','ra-default'],n=>'/etc/gale/ipv6-before/'+n),'/usr/share/nftables.d/chain-pre/forward/40-gale-guard.nft','/usr/share/nftables.d/chain-pre/input/40-gale-guard.nft'];
function unhex(value){let out='';for(let i=0;i<length(value);i+=2){let n=0;for(let j=0;j<2;j++){let c=index('0123456789abcdef',substr(value,i+j,1));if(c<0)die('BAD_HEX');n=n*16+c;}out+=chr(n);}return out;}
export function recovery_hmac(key,body){if(length(key)>64)key=unhex(sha256(key));let inner='',outer='';for(let i=0;i<64;i++){let n=i<length(key)?ord(key,i):0;inner+=chr(n^54);outer+=chr(n^92);}return sha256(outer+unhex(sha256(inner+body)));};
function equal(a,b){if(type(a)!='string'||type(b)!='string'||length(a)!=length(b))return false;let diff=0;for(let i=0;i<length(a);i++)diff|=ord(a,i)^ord(b,i);return diff==0;}
export function recovery_key(create){let path='/etc/gale/recovery-signing.key',key=readfile(path);if(key&&length(key)==32)return key;if(key)die('RECOVERY_KEY_CORRUPT');if(!create)die('RECOVERY_KEY_REQUIRED');let f=open('/dev/urandom','r');if(!f)die('RANDOM_SOURCE_UNAVAILABLE');key=f.read(32);f.close();if(length(key)!=32)die('RANDOM_SOURCE_UNAVAILABLE');if(writefile(path+'.new',key)!=32)die('RECOVERY_KEY_WRITE_FAILED');chmod(path+'.new',0o600);if(!rename(path+'.new',path))die('RECOVERY_KEY_COMMIT_FAILED');system(['/bin/sync'],5000);return key;};
export function recovery_device(){let b=connect().call('system','board',{}),mac=readfile('/sys/class/ieee80211/phy0/macaddress')||readfile('/sys/class/net/eth0/address');if(!mac||!b?.board_name)die('HARDWARE_ID_UNAVAILABLE');return {hardware_hash:sha256(b.board_name+'|'+trim(mac)),board:b.board_name,firmware:b.release?.revision,target:b.release?.target};};
function valid_id(id){return type(id)=='string'&&!!match(id,/^[a-z0-9-]{1,80}$/);}
function valid_relative(path){return type(path)=='string'&&!!match(path,/^[a-zA-Z0-9._\/-]+$/)&&!('..' in split(path,'/'))&&substr(path,0,1)!='/';}
export function recovery_code(){let registry=json(readfile('/etc/gale/releases.json')||'null');if(!registry||registry.pending||!valid_id(registry.current))die('STABLE_VERSIONED_INSTALL_REQUIRED');let root='/usr/share/gale/releases/'+registry.current,manifest=readfile(root+'/SHA256SUMS');if(!manifest||sha256(manifest)!=registry.manifests[registry.current])die('RELEASE_MANIFEST_MISMATCH');let files={};for(let line in split(trim(manifest),'\n')){let parts=split(line,/\s+/),path=parts[1];if(!valid_relative(path)||length(keys(files))>=512)die('BAD_RELEASE_MANIFEST');let content=readfile(root+'/'+path);if(content==null||sha256(content)!=parts[0])die('CURRENT_RELEASE_INTEGRITY_FAILED');files[path]={data:b64enc(content),mode:stat(root+'/'+path).mode&0o777};}if(!files['helpers/recovery-worker.uc']||!files['helpers/recovery-task'])die('FULL_RECOVERY_RELEASE_REQUIRED');files.SHA256SUMS={data:b64enc(manifest),mode:0o644};return {id:registry.current,manifest_hash:registry.manifests[registry.current],files:files};};
export function export_recovery(){let files={};for(let n in system_names){let content=readfile('/etc/config/'+n);if(type(content)!='string'||length(content)>262144)die('SYSTEM_CONFIG_UNAVAILABLE');files[n]=content;}let settings={};for(let n in ['routing-draft.json','routing-active.json','network-options.json','discovery-options.json','cores.json']){let raw=readfile('/etc/gale/'+n);settings[n]=raw?json(raw):null;}if(settings['network-options.json']?.ipv6_tunnel&&!exists(settings['network-options.json'],'ipv6_original_ra_default'))settings['network-options.json'].ipv6_original_ra_default=trim(readfile('/etc/gale/ipv6-before/ra-default')||'')||null;let host_keys={};for(let name in host_key_names){let data=readfile('/etc/dropbear/'+name);host_keys[name]=data==null?null:b64enc(data);}let active=readfile('/etc/gale/runtime/active'),payload=sprintf('%J',{created_at:time(),device:recovery_device(),store:load_store(),settings:settings,connection:active?json(active):null,lan:!!connect().call('gale-connection','status',{})?.routing?.active,system:files,host_keys:host_keys,code:recovery_code()}),result=sprintf('%J',{format:'gale-recovery',version:1,payload:payload,signature:recovery_hmac(recovery_key(true),payload)});if(length(result)>8388608)die('RECOVERY_BUNDLE_LIMIT');return result;};
function validate_system(files){if(type(files)!='object'||length(keys(files))!=length(system_names))die('BAD_SYSTEM_CONFIG_SET');let dir=mkdtemp('/tmp/gale-system-check-XXXXXX');if(!dir)die('RECOVERY_STORAGE_FAILED');chmod(dir,0o700);let error=null;try{for(let n in system_names){if(type(files[n])!='string'||length(files[n])>262144||index(files[n],'\u0000')>=0)die('BAD_SYSTEM_CONFIG');writefile(dir+'/'+n,files[n]);chmod(dir+'/'+n,0o600);if(system(['/usr/share/gale/capture',dir+'/output','/sbin/uci','-c',dir,'-q','export',n],5000)!=0)die('SYSTEM_CONFIG_SYNTAX_REJECTED');}for(let item in [{key:'network.lan.ipaddr',expected:'192.168.10.1'},{key:'network.lan.device',expected:'br-lan'}]){if(system(['/usr/share/gale/capture',dir+'/output','/sbin/uci','-c',dir,'-q','get',item.key],5000)!=0||!(trim(readfile(dir+'/output')||'') in (item.key=='network.lan.ipaddr'?['192.168.10.1','192.168.10.1/24']:[item.expected])))die('RECOVERY_LAN_LAYOUT_UNSUPPORTED');}}catch(e){error=e.message;}for(let n in [...system_names,'output'])unlink(dir+'/'+n);rmdir(dir);if(error)die(error);}
export function inspect_recovery(content){if(type(content)!='string'||length(content)>8388608)die('RECOVERY_BUNDLE_LIMIT');let envelope;try{envelope=json(content);}catch(e){die('BAD_RECOVERY_JSON');}if(envelope?.format!='gale-recovery'||envelope.version!=1||type(envelope.payload)!='string')die('BAD_RECOVERY_FORMAT');if(!equal(envelope.signature,recovery_hmac(recovery_key(false),envelope.payload)))die('RECOVERY_SIGNATURE_REJECTED');let p=json(envelope.payload),device=recovery_device();if(p.device?.hardware_hash!=device.hardware_hash||p.device?.firmware!=device.firmware||p.device?.target!=device.target)die('RECOVERY_DEVICE_OR_FIRMWARE_MISMATCH');
 let store=restore_catalog({format:'gale-catalog',version:1,store:p.store});for(let id,source in store.sources){let old=p.store.sources[id];if(!(old.refresh_interval in [null,0,3600,21600,86400]))die('BAD_SOURCE_SCHEDULE');source.enabled=!!old.enabled;source.refresh_interval=old.refresh_interval||0;}for(let id,profile in store.profiles){profile.source_retired=!!p.store.profiles[id].source_retired;}
 for(let n in ['routing-draft.json','routing-active.json']){let draft=p.settings?.[n];if(draft){if(!(draft.default_action in ['vpn','direct']))die('BAD_RECOVERY_POLICY');validate_device_rules(map(draft.rules||[],r=>({ip:r.ip||r.observed_ip,action:r.action})),[]);}}
 let desired=[];for(let id,old in p.store.profiles)if(old.enabled)push(desired,id);if(p.connection){if(!(p.connection.mode in ['manual','best','failover','balanced']))die('BAD_RECOVERY_CONNECTION');connection_policy(p.connection.policy);for(let id in p.connection.pool||[p.connection.profile_id]){if(!exists(store.profiles,id))die('RECOVERY_PROFILE_MISSING');if(!(id in desired))push(desired,id);}if(!(p.connection.profile_id in desired))die('BAD_RECOVERY_PRIMARY');}
 for(let name,value in p.host_keys||{}){if(!(name in host_key_names))die('BAD_RECOVERY_HOST_KEY');if(value!=null){let decoded=type(value)=='string'?b64dec(value):null;if(type(decoded)!='string'||length(decoded)>16384||(!length(decoded)&&name!='authorized_keys'))die('BAD_RECOVERY_HOST_KEY');}}validate_system(p.system);let code=p.code;if(!valid_id(code?.id)||!match(code.manifest_hash||'',/^[a-f0-9]{64}$/)||type(code.files)!='object'||length(keys(code.files))>512)die('BAD_RECOVERY_CODE');let manifest=b64dec(code.files.SHA256SUMS?.data||'');if(!manifest||sha256(manifest)!=code.manifest_hash)die('RECOVERY_CODE_MANIFEST_REJECTED');for(let path,file in code.files){if(!valid_relative(path)||type(file.data)!='string'||type(file.mode)!='int'||file.mode<0||file.mode>0o777)die('BAD_RECOVERY_CODE_FILE');}for(let line in split(trim(manifest),'\n')){let f=split(line,/\s+/);if(!valid_relative(f[1])||sha256(b64dec(code.files[f[1]]?.data||''))!=f[0])die('RECOVERY_CODE_FILE_REJECTED');}
 let changed=[];for(let n in system_names)if(readfile('/etc/config/'+n)!=p.system[n])push(changed,n);
 return {payload:p,store:store,validate_ids:desired,summary:{profiles:length(keys(store.profiles)),sources:length(keys(store.sources)),enabled_profiles:length(desired),changed_system_configs:changed,code_version:code.id,restore_scope:'Gale_code_catalog_routing_runtime_and_six_system_configs',firmware_image_included:false,client_confirmation_required:true}};
};
