import {resolve_public_endpoint} from '/usr/share/gale/lib/addresses.uc';
function scan(value,depth){if(depth>12)die('XHTTP_EXTRA_DEPTH_LIMIT');if(type(value)=='object'){for(let key in keys(value)){if(match(key,/(_path|_file|Path|File)$/)||match(key,/masterkeylog|key_log|dialerproxy|proxysettings/i))die('XHTTP_EXTERNAL_REFERENCE_NOT_SUPPORTED');if(key=='sockopt'){for(let option in keys(value[key]||{}))if(!(option in ['tcpFastOpen','tcpKeepAliveIdle','tcpKeepAliveInterval','tcpNoDelay','tcpCongestion','tcpUserTimeout','domainStrategy','happyEyeballs']))die('XHTTP_SOCKET_OPTION_NOT_SUPPORTED');}scan(value[key],depth+1);}}else if(type(value)=='array')for(let item in value)scan(item,depth+1);}
export function validate_extra(extra){scan(extra,0);let d=extra.downloadSettings;if(!d)return;if(type(d)!='object'||d.network!='xhttp')die('XHTTP_DOWNLOAD_NETWORK_REQUIRED');if(type(d.address)!='string'||!match(d.address,/^[A-Za-z0-9][A-Za-z0-9.:-]{0,252}$/)||type(d.port)!='int'||d.port<1||d.port>65535)die('XHTTP_DOWNLOAD_ENDPOINT_REQUIRED');if(!(d.security in ['tls','reality']))die('XHTTP_DOWNLOAD_SECURITY_REQUIRED');if(d.xhttpSettings?.extra?.downloadSettings)die('NESTED_XHTTP_DOWNLOAD_NOT_SUPPORTED');};
export function extra_insecure(extra){return extra?.downloadSettings?.tlsSettings?.allowInsecure===true;};
export function pin_download(stream){let d=stream?.xhttpSettings?.extra?.downloadSettings;if(!d)return;let host=d.address,ipv6=index(host,':')>=0;d.address=resolve_public_endpoint(host,ipv6?6:4)[0];if(d.tlsSettings&&!d.tlsSettings.serverName)d.tlsSettings.serverName=host;if(d.xhttpSettings&&!d.xhttpSettings.host)d.xhttpSettings.host=host;};
