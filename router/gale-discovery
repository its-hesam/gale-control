#!/usr/bin/ucode
import {readfile,writefile,open,mkdir,stat,chmod,unlink,popen} from 'fs';
if(ARGV[0]=='list'){print({status:{},start:{limit:'Integer'},cancel:{},configure:{enabled:'Boolean',interval:'Integer',limit:'Integer'},run_due:{}});exit(0);}if(ARGV[0]!='call')exit(1);
let dir='/tmp/gale-discovery';if(!stat(dir))mkdir(dir);chmod(dir,0o700);function doc(path,fallback){try{return json(readfile(path)||'null')||fallback;}catch(e){return fallback;}}
try{
 let settings=doc('/etc/gale/discovery-options.json',{enabled:false,interval:21600,limit:20}),job=doc(dir+'/job.json',null);
 if(job?.state in ['queued','sources','validating','probing']&&time()-job.updated_at>120)job={...job,state:'interrupted'};
 if(ARGV[1]=='status'){print({schema_version:1,settings:settings,job:job});exit(0);}
 if(ARGV[1]=='cancel'){writefile(dir+'/cancel','1');print({schema_version:1,state:'cancellation_requested'});exit(0);}
 let req=json(readfile('/dev/stdin')||'{}');
 if(stat('/etc/gale/recovery/pending.json'))die('SYSTEM_RECOVERY_RUNNING');
 if(ARGV[1]=='configure'){if(type(req.enabled)!='bool'||!(req.interval in [3600,21600,86400])||type(req.limit)!='int'||req.limit<1||req.limit>50)die('BAD_DISCOVERY_SETTINGS');if(req.enabled&&system(['/usr/share/gale/install-scheduler'],5000)!=0)die('SCHEDULER_INSTALL_FAILED');settings={enabled:req.enabled,interval:req.interval,limit:req.limit,updated_at:time()};writefile('/etc/gale/discovery-options.json',sprintf('%J',settings));chmod('/etc/gale/discovery-options.json',0o600);print({schema_version:1,settings:settings});exit(0);}
 if(ARGV[1]=='run_due'&&(!settings.enabled||time()-(job?.started_at||0)<settings.interval)){print({schema_version:1,state:'not_due'});exit(0);}
 if(!(ARGV[1] in ['start','run_due']))die('UNKNOWN_METHOD');if(stat('/etc/gale/core-upgrade.pending'))die('CORE_UPGRADE_RUNNING');
 let lock=open(dir+'/queue.lock','a',0o600);if(!lock||!lock.lock('xn'))die('DISCOVERY_BUSY');if(job?.state in ['queued','sources','validating','probing'])die('DISCOVERY_RUNNING');let limit=req.limit||settings.limit;if(type(limit)!='int'||limit<1||limit>50)die('BAD_DISCOVERY_LIMIT');
 job={state:'queued',limit:limit,source_total:0,source_processed:0,source_failed:0,validated:0,probed:0,passed:0,skipped_openvpn:0,skipped_busy:0,errors:{},started_at:time(),updated_at:time()};unlink(dir+'/cancel');writefile(dir+'/job.json',sprintf('%J',job));lock.close();let child=popen('/usr/share/gale/discovery-launch','r');if(!child||child.close()!=0)die('DISCOVERY_LAUNCH_FAILED');print({schema_version:1,job:job});
}catch(e){print({schema_version:1,error:match(e.message||'',/^[A-Z0-9_]+$/)?e.message:'DISCOVERY_OPERATION_FAILED'});}
