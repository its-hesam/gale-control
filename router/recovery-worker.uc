import {readfile,writefile,rename,chmod,stat,mkdir,open,popen,unlink} from 'fs';import {sha256} from 'digest';import {connect} from 'ubus';
import {inspect_recovery,recovery_paths} from '/usr/share/gale/lib/recovery.uc';import {lock_store,load_store,save_store} from '/usr/share/gale/lib/store.uc';
let root='/etc/gale/recovery',jobroot='/tmp/gale-full-restore',req=json(readfile(jobroot+'/request.json')||'{}'),lock=open(root+'/restore.lock','a',0o600);if(!lock||!lock.lock('xn'))exit(0);let snapshot=null,guard=false,code_changed=false,committed=false,job={id:req.id,state:'preparing',validated:0,validate_total:0,started_at:time(),updated_at:time()};
function atomic(path,body){if(writefile(path+'.new',body)!=length(body))die('RECOVERY_WRITE_FAILED');chmod(path+'.new',0o600);if(!rename(path+'.new',path))die('RECOVERY_COMMIT_FAILED');}
function save(state,error){job.state=state;job.error=error||null;job.updated_at=time();atomic(jobroot+'/job.json',sprintf('%J',job));if(state in ['complete','rolled_back','recovery_required','committed_cleanup_required','failed'])atomic(root+'/last-result.json',sprintf('%J',job));}
function execute(args,timeout){if(system(args,timeout||15000)!=0)die('RECOVERY_OPERATION_FAILED');}
function code_transaction(mode,value){atomic(root+'/transaction-request.json',sprintf('%J',value));execute(['/usr/bin/ucode','/usr/share/gale-release-transaction.uc',mode,'--recovery-request'],35000);}

function parents(path){let current='';for(let p in slice(split(path,'/'),1,-1)){current+='/'+p;if(!stat(current))mkdir(current,0o755);}}
function code_stage(code){let dir='/usr/share/gale/releases/'+code.id,registry=json(readfile('/etc/gale/releases.json'));if(stat(dir)&&system(['/bin/sh','-c','cd '+dir+' && sha256sum -c SHA256SUMS >/dev/null 2>&1'],30000)==0)return;if(registry.current==code.id)die('ACTIVE_CODE_REPAIR_REQUIRES_FALLBACK');for(let relative,file in code.files){let path=dir+'/'+relative;parents(path);let data=b64dec(file.data);if(writefile(path+'.restore',data)!=length(data))die('RECOVERY_CODE_WRITE_FAILED');chmod(path+'.restore',file.mode);if(!rename(path+'.restore',path))die('RECOVERY_CODE_COMMIT_FAILED');}execute(['/bin/sh','-c','cd '+dir+' && sha256sum -c SHA256SUMS >/dev/null 2>&1'],30000);execute(['/bin/sync'],5000);}
function live_ready(id,after,lan,permanent){let s=connect().call('gale-connection','status',{});return s?.running&&s.health?.ok&&s.health.profile_id==id&&s.health.checked_at>=after&&(!lan||s.routing?.active)&&(!permanent||s.routing?.persistent_guard_active);}
try{
 let release_lock=open('/etc/gale/release.lock','a',0o600),core_lock=open('/etc/gale/core-upgrade.lock','a',0o600),policy_lock=open('/tmp/gale-policy-operation/apply.lock','a',0o600);if(!release_lock||!release_lock.lock('xn')||!core_lock||!core_lock.lock('xn')||(stat('/tmp/gale-policy-operation')&&(!policy_lock||!policy_lock.lock('xn'))))die('SYSTEM_OPERATION_BUSY');
 let probe_lock=open('/etc/gale/probe.lock','a',0o600);if(!probe_lock||!probe_lock.lock('xn'))die('PROBE_BUSY');
 if(stat('/etc/gale/core-upgrade.pending')||stat(root+'/pending.json'))die('RECOVERY_ALREADY_PENDING');let content=readfile('/etc/gale/restore-full.json');if(!content||sha256(content)!=req.revision)die('RECOVERY_PREVIEW_CHANGED');let plan=inspect_recovery(content),p=plan.payload;job.validate_total=length(plan.validate_ids);save('preparing');code_stage(p.code);
 let before=connect().call('gale-connection','status',{});snapshot={encoding:'base64',files:{},init_flags:{},lan_required:!!before?.routing?.active,guard_required:!!before?.routing?.persistent_guard_active};for(let path in recovery_paths){let data=readfile(path);snapshot.files[path]=data==null?null:{data:b64enc(data),mode:stat(path).mode&0o777};}for(let n in ['gale-tunnel','gale-network','gale-route-watch','gale-monitor'])snapshot.init_flags[n]=system(['/etc/init.d/'+n,'enabled'],2000)==0;
 let cron=popen('crontab -l 2>/dev/null','r');snapshot.gale_scheduler=cron?index(cron.read('all')||'','# gale-source-scheduler')>=0:false;if(cron)cron.close();
 let serialized=sprintf('%J',snapshot);atomic(root+'/snapshot.json',serialized);atomic(root+'/snapshot.copy',serialized);let pending={id:req.id,phase:'applying',snapshot_hash:sha256(serialized),created_at:time()};execute(['/bin/sync'],5000);atomic(root+'/pending.json',sprintf('%J',pending));execute(['/bin/sync'],5000);
 let timeout=180+job.validate_total*5;writefile(root+'/worker.pid',split(readfile('/proc/self/stat'),' ')[0]+'\n');chmod(root+'/worker.pid',0o600);let child=popen('/usr/share/gale/recovery-watchdog '+timeout+' </dev/null >/dev/null 2>&1 &','r');if(!child||child.close()!=0)die('RECOVERY_WATCHDOG_FAILED');
 execute(['/usr/share/gale/recovery-guard','install'],5000);guard=true;save('applying');execute(['/etc/init.d/gale-network','stop'],5000);execute(['/etc/init.d/gale-tunnel','stop'],8000);
 if(stat('/etc/gale/network-options.json')||stat('/usr/share/nftables.d/chain-pre/forward/40-gale-guard.nft'))execute(['/usr/share/gale/network-guard-remove'],20000);if(stat('/etc/gale/routing-test/armed'))execute(['/usr/share/gale/routing-rollback'],15000);
 {let storage=lock_store();save_store(plan.store);storage.close();}
 if(p.settings['cores.json'])atomic('/etc/gale/cores.json',sprintf('%J',p.settings['cores.json']));
 let registry=json(readfile('/etc/gale/releases.json'));if(registry.current!=p.code.id){code_transaction('prepare',{id:p.code.id,manifest_hash:p.code.manifest_hash});code_changed=true;execute(['/etc/init.d/rpcd','reload'],5000);}
 let target='/usr/share/gale/releases/'+p.code.id;save('validating');for(let id in plan.validate_ids){if(stat(jobroot+'/cancel'))die('RECOVERY_CANCELLED');execute(['/usr/bin/env','GALE_RECOVERY_INTERNAL=1',target+'/helpers/capture',root+'/validation.json',target+'/helpers/profile-task','validate',id],10000);let result=json(readfile(root+'/validation.json')||'{}');if(!result.passed)die('RECOVERY_PROFILE_NATIVE_REJECTED');job.validated++;save('validating');}
 {let storage=lock_store(),store=load_store();for(let id,profile in store.profiles)profile.enabled=!!p.store.profiles[id]?.enabled&&profile.native_status=='passed';save_store(store);storage.close();}
 if(length(filter(values(p.store.sources),s=>s.enabled&&s.refresh_interval>0))||p.settings['discovery-options.json']?.enabled)execute([target+'/helpers/install-scheduler'],5000);else execute([target+'/helpers/scheduler-remove'],5000);
 for(let name in ['routing-draft.json','routing-active.json','discovery-options.json']){let value=p.settings[name];if(value)atomic('/etc/gale/'+name,sprintf('%J',value));else unlink('/etc/gale/'+name);}
 let host_keys_changed=false;for(let name,value in p.host_keys||{}){let data=value==null?null:b64dec(value);if(readfile('/etc/dropbear/'+name)!=data){if(data==null)unlink('/etc/dropbear/'+name);else atomic('/etc/dropbear/'+name,data);host_keys_changed=true;}}
 for(let name in plan.summary.changed_system_configs)atomic('/etc/config/'+name,p.system[name]);if(length(plan.summary.changed_system_configs)){save('reloading_network');execute(['/etc/init.d/network','reload'],15000);execute(['/etc/init.d/dnsmasq','reload'],5000);execute(['/etc/init.d/odhcpd','reload'],5000);execute(['/etc/init.d/uhttpd','reload'],5000);execute(['/etc/init.d/dropbear','reload'],5000);}
 if(host_keys_changed&&!length(plan.summary.changed_system_configs))execute(['/etc/init.d/dropbear','reload'],5000);
 save('reconnecting');if(p.connection){let a=p.connection;atomic(root+'/connection-request.json',sprintf('%J',{id:a.profile_id,mode:a.mode||'manual',pool_scope:a.pool_scope||'selected',pool:join(',',a.pool||[a.profile_id]),policy:sprintf('%J',a.policy),automatic:true,auto_connect:!!a.auto_connect,lan:!!p.lan}));execute([target+'/helpers/capture',root+'/command.json',target+'/helpers/recovery-task','connect'],15000);let connection_result=json(readfile(root+'/command.json')||'{}');if(connection_result.error)die(match(connection_result.error,/^[A-Z0-9_]+$/)?connection_result.error:'RECOVERY_CONNECTION_REJECTED');let began=time(),ready=false;for(let i=0;i<100;i++){if(live_ready(a.profile_id,began,!!p.lan,!!p.settings['network-options.json']?.kill_switch)){ready=true;break;}system(['/bin/sleep','1'],2000);}if(!ready)die('RECOVERY_LAN_HEALTH_FAILED');}else{unlink('/etc/gale/runtime/active');execute(['/etc/init.d/gale-tunnel','disable'],2000);}
 if(p.settings['network-options.json']?.ipv6_tunnel){let baseline=p.settings['network-options.json'].ipv6_original_ra_default;if(baseline in ['0','1','2'])execute(['/sbin/uci','set','dhcp.lan.ra_default='+baseline],3000);else system(['/sbin/uci','-q','delete','dhcp.lan.ra_default'],3000);execute(['/sbin/uci','commit','dhcp'],3000);execute([target+'/helpers/ipv6-apply','--owner-approved-ipv6-trial'],20000);}
 job.confirm_before=time()+90;save('awaiting_client_confirmation');atomic(jobroot+'/job.json',sprintf('%J',job));let accepted=false;for(let i=0;i<90;i++){if(readfile(jobroot+'/confirm')==req.id){accepted=true;break;}if(stat(jobroot+'/cancel'))die('RECOVERY_CANCELLED');system(['/bin/sleep','1'],2000);}if(!accepted)die('RECOVERY_CLIENT_CONFIRMATION_EXPIRED');
 if(p.connection&&!live_ready(p.connection.profile_id,0,!!p.lan,!!p.settings['network-options.json']?.kill_switch))die('RECOVERY_FINAL_HEALTH_FAILED');if(p.settings['network-options.json']?.ipv6_tunnel)atomic('/etc/gale/ipv6-before/committed','1');if(code_changed)code_transaction('commit',{id:p.code.id});execute(['/bin/sync'],5000);pending.phase='committed';atomic(root+'/pending.json',sprintf('%J',pending));execute(['/bin/sync'],5000);committed=true;unlink(root+'/pending.json');execute(['/bin/sync'],5000);execute(['/usr/share/gale/recovery-guard','remove'],5000);guard=false;save('complete');
}catch(e){let code=match(e.message||'',/^[A-Z0-9_]+$/)?e.message:'FULL_RECOVERY_FAILED';if(snapshot&&!committed&&stat(root+'/pending.json')){save('rolling_back',code);system(['/etc/init.d/gale-network','stop'],5000);system(['/etc/init.d/gale-tunnel','stop'],8000);let restored=system(['/usr/bin/ucode','/usr/share/gale-state-recover.uc'],35000)==0;system(['/sbin/fw4','reload'],15000);system(['/usr/share/gale/routing-rollback','--preserve-ipv6'],15000);system(['/etc/init.d/network','reload'],15000);system(['/etc/init.d/dnsmasq','reload'],5000);system(['/etc/init.d/odhcpd','reload'],5000);system(['/etc/init.d/rpcd','reload'],5000);if(snapshot.files['/etc/gale/runtime/active'])system(['/etc/init.d/gale-tunnel','start'],8000);if(snapshot.init_flags['gale-network'])system(['/etc/init.d/gale-network','start'],5000);let ready=!snapshot.files['/etc/gale/runtime/active'];for(let i=0;!ready&&i<90;i++){ready=live_ready(json(b64dec(snapshot.files['/etc/gale/runtime/active'].data)).profile_id,0,snapshot.lan_required,snapshot.guard_required);if(!ready)system(['/bin/sleep','1'],2000);}if(restored&&ready){if(guard)system(['/usr/share/gale/current/helpers/recovery-guard','remove'],5000);save('rolled_back',code);}else save('recovery_required',code);}else save(committed?'committed_cleanup_required':'failed',code);}
