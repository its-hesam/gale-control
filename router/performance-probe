#!/bin/sh
set -eu
directory=$1
case "$directory" in /tmp/gale-probe-*) ;; *) exit 1 ;; esac
test -f "$directory/config.json"
core=xray
if [ -f "$directory/core" ]; then read -r core <"$directory/core" || true; fi
case "$core" in xray|sing-box) ;; *) exit 1 ;; esac
binary=/usr/bin/$core
if [ -f "$directory/binary" ]; then read -r binary <"$directory/binary" || true; fi
case "$binary" in /usr/bin/xray|/usr/bin/sing-box|/usr/share/gale/managed/xray/*/core|/usr/share/gale/managed/sing-box/*/core) ;; *) exit 1 ;; esac
/usr/bin/timeout 65 /bin/sh -c 'echo "$$" >"$1/core.pid"; exec "$2" run -c "$1/config.json"' gale "$directory" "$binary" >"$directory/core.log" 2>&1 &
supervisor_pid=$!
cleanup() {
 if [ -f "$directory/core.pid" ]; then
  read -r core_pid <"$directory/core.pid"
  case "$core_pid" in ''|*[!0-9]*) ;; *)
   if [ "$(readlink "/proc/$core_pid/exe" 2>/dev/null)" = "$binary" ]; then
    if tr '\000' '\n' <"/proc/$core_pid/cmdline" | grep -Fxq "$directory/config.json"; then kill -KILL "$core_pid" 2>/dev/null || true; fi
   fi ;;
  esac
 fi
 kill -KILL "$supervisor_pid" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM
sleep 1
kill -0 "$supervisor_pid" 2>/dev/null || exit 3
read -r running_pid <"$directory/core.pid"
test "$(readlink "/proc/$running_pid/exe" 2>/dev/null)" = "$binary" || exit 3
tr '\000' '\n' <"/proc/$running_pid/cmdline" | grep -Fxq "$directory/config.json" || exit 3
ready=no
for attempt in 1 2 3 4 5; do
 if awk '$2 ~ /:45E3$/ && $4 == "0A" {ready=1} END {exit ready?0:1}' /proc/net/tcp /proc/net/tcp6; then ready=yes; break; fi
 kill -0 "$running_pid" 2>/dev/null || exit 3
 sleep 1
done
test "$ready" = yes || exit 3
for n in 1 2 3; do
 /usr/bin/curl --disable --silent --proxy '' --noproxy '' --socks5-hostname 127.0.0.1:17891 --proto '=https' --connect-timeout 3 --max-time 4 --output /dev/null --write-out '%{json}' https://www.gstatic.com/generate_204 >"$directory/https-$n.json" 2>/dev/null || true
done
read -r dns <"$directory/dns-target" || true
for n in 1 2 3 4 5; do
 /usr/bin/timeout 3 /usr/bin/ucode /usr/share/gale/udp-benchmark-sample.uc "$directory" "$n" "$dns" >"$directory/udp-$n.json" 2>/dev/null || true
done
/usr/bin/curl --disable --silent --proxy '' --noproxy '' --socks5-hostname 127.0.0.1:17891 --proto '=https' --connect-timeout 3 --max-time 8 --max-filesize 1048576 --output /dev/null --write-out '%{json}' 'https://speed.cloudflare.com/__down?bytes=1048576' >"$directory/download.json" 2>/dev/null || true
dd if=/dev/zero of="$directory/upload.bin" bs=1024 count=256 2>/dev/null
/usr/bin/curl --disable --silent --proxy '' --noproxy '' --socks5-hostname 127.0.0.1:17891 --proto '=https' --connect-timeout 3 --max-time 8 --max-filesize 16384 --data-binary "@$directory/upload.bin" --output /dev/null --write-out '%{json}' https://speed.cloudflare.com/__up >"$directory/upload.json" 2>/dev/null || true
