#!/bin/sh
set -eu
case "$1" in /usr/share/gale/download-*) ;; *) exit 1 ;; esac
case "$2" in xray|sing-box) ;; *) exit 1 ;; esac
printf '%s' "$3" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'
if [ "$2" = xray ]; then unzip -p "$1/archive" xray >"$1/core"; else tar -xzOf "$1/archive" "sing-box-$3-linux-armv7/sing-box" >"$1/core"; fi
chmod 755 "$1/core"
