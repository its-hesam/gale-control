import {readfile,writefile,rename,unlink,open,chmod,stat} from 'fs';import {connect} from 'ubus';import {activate_core} from '/usr/share/gale/lib/core-activation.uc';import {recover_core} from '/usr/share/gale/lib/core-recovery.uc';import {load_store,lock_store,save_store} from '/usr/share/gale/lib/store.uc';import {validate_core} from '/usr/share/gale/lib/adapter.uc';import {event_add} from '/usr/share/gale/lib/events.uc';
let dir='/tmp/gale-core-upgrade',lock=open('/etc/gale/core-upgrade.lock','a',0o600);if(!lock||!lock.lock('xn'))exit(0);let req=json(readfile(dir+'/request.json')||'{}'),snapshot=null,coordinator=false,changed=false;
function save(state,error){writefile(dir+'/job.new',sprintf('%J',{state:state,error:error||null,id:req.id,version:req.version,updated_at:time()}));rename(dir+'/job.new',dir+'/job.json');event_add('core_upgrade',error||state);}
function start_connection(active){let ctl=open('/tmp/gale-connection/control.lock','a',0o600);if(!ctl||!ctl.lock('xn'))die('CONNECTION_BUSY');writefile('/tmp/gale-connection/request.json',sprintf('%J',{id:active.profile_id,mode:active.mode||'manual',pool_scope:active.pool_scope||'selected',pool:active.pool||[active.profile_id],policy:active.policy,auto_connect:!!active.auto_connect,automatic:true,lan:false}));ctl.close();if(system(['/usr/bin/ucode','/usr/share/gale/connection-worker.uc'],18000)!=0)die('UPGRADE_CONNECTION_START_FAILED');}
function wait_health(id,after,network){let bus=connect();for(let i=0;i<45;i++){let status=bus.call('gale-connection','status',{});if(status?.running&&status.health?.ok&&status.health.profile_id==id&&status.health.checked_at>=after&&time()-status.health.checked_at<30&&(!network||status.routing?.active))return true;system(['/bin/sleep','1'],2000);}return false;}

try{
 unlink(dir+'/cancel');save('preparing');let policy_lock=open('/tmp/gale-policy-operation/apply.lock','a',0o600);if(stat('/tmp/gale-policy-operation')&&(!policy_lock||!policy_lock.lock('xn')))die('POLICY_BUSY');if(stat('/etc/gale/core-upgrade.pending'))die('CORE_RECOVERY_REQUIRED');if(!(req.id in ['xray','sing-box'])||!match(req.version||'',/^[0-9]+\.[0-9]+\.[0-9]+$/))die('BAD_CORE_VERSION');if(!stat('/usr/share/gale/managed/'+req.id+'/'+req.version+'/receipt.json'))die('CORE_NOT_STAGED');
 let receipt=json(readfile('/usr/share/gale/managed/'+req.id+'/'+req.version+'/receipt.json'));if(!match(receipt.binary_sha256||'',/^[0-9a-f]{64}$/)||system(['/usr/share/gale/verify-core','/usr/share/gale/managed/'+req.id+'/'+req.version,receipt.binary_sha256],5000)!=0)die('CORE_HASH_MISMATCH');
 if(system(['/usr/share/gale/capture',dir+'/preflight','/usr/share/gale/managed/'+req.id+'/'+req.version+'/core',req.id=='xray'?'run':'check',...(req.id=='xray'?['-test']:[]),'-c','/usr/share/gale/selftests/'+(req.id=='xray'?'xray-direct.json':'sing-box-direct.json')],5000)!=0)die('CORE_SCHEMA_PREFLIGHT_FAILED');
 let ctl=open('/tmp/gale-connection/control.lock','a',0o600),worker=open('/tmp/gale-connection/worker.lock','a',0o600);if(!ctl||!ctl.lock('xn')||!worker||!worker.lock('xn'))die('CONNECTION_BUSY');
 let runtime={},metadata={},store=load_store();for(let f in ['config.json','binary','active','sidecars','sidecar-1.json','sidecar-2.json','binary-1','binary-2'])runtime[f]=readfile('/etc/gale/runtime/'+f);
 if(stat('/etc/gale/runtime/pending'))die('CONNECTION_RECOVERY_REQUIRED');
 for(let id in keys(store.profiles)){let p=store.profiles[id],m={};for(let f in ['native_status','native_core','native_core_version','native_error','native_checked_at','enabled','last_test','last_performance','last_udp_test','handshake_status'])if(exists(p,f))m[f]=p[f];metadata[id]=m;}
 snapshot={routing_required:!!stat('/etc/gale/routing-test/armed'),registry:readfile('/etc/gale/cores.json'),runtime:runtime,metadata:metadata,boot_id:trim(readfile('/proc/sys/kernel/random/boot_id')||'')};let serialized=sprintf('%J',snapshot);if(writefile('/etc/gale/core-upgrade.pending.new',serialized)!=length(serialized))die('CORE_SNAPSHOT_WRITE_FAILED');chmod('/etc/gale/core-upgrade.pending.new',0o600);if(!rename('/etc/gale/core-upgrade.pending.new','/etc/gale/core-upgrade.pending'))die('CORE_SNAPSHOT_COMMIT_FAILED');if(system(['/bin/sync'],5000)!=0)die('CORE_SNAPSHOT_SYNC_FAILED');
 changed=true;coordinator=system(['/etc/init.d/gale-network','enabled'],2000)==0;if(coordinator)system(['/etc/init.d/gale-network','stop'],5000);system(['/etc/init.d/gale-tunnel','stop'],8000);unlink('/etc/gale/runtime/active');worker.close();ctl.close();
 activate_core(req.id,req.version);save('testing');if(getenv('GALE_UPGRADE_FAULT')=='after_activation')die('INJECTED_AFTER_ACTIVATION');
 if(runtime.active){let active=json(runtime.active),guard=lock_store(),updated=load_store();try{for(let id in active.pool||[active.profile_id]){let p=updated.profiles[id];if(!p)die('PROFILE_REMOVED_DURING_UPGRADE');let result=validate_core(p,updated.security);if(!result.passed)die('UPGRADED_PROFILE_SCHEMA_REJECTED');p.native_status='passed';p.native_core=result.core;p.native_core_version=result.feature_version||result.compatibility_version||null;p.native_checked_at=time();p.enabled=!!metadata[id]?.enabled;}save_store(updated);}catch(error){guard.close();die(error.message);}guard.close();start_connection(active);
  let healthy=false,bus=connect();for(let i=0;i<45;i++){if(stat(dir+'/cancel'))die('UPGRADE_CANCELLED');let s=bus.call('gale-connection','status',{});if(s?.running&&s.health?.ok&&time()-s.health.checked_at<30){healthy=true;break;}system(['/bin/sleep','1'],2000);}if(!healthy)die('UPGRADED_HTTPS_FAILED');
 }
 unlink('/etc/gale/core-upgrade.pending');if(coordinator)system(['/etc/init.d/gale-network','start'],5000);save('complete');
}catch(e){let code=match(e.message||'',/^[A-Z0-9_]+$/)?e.message:'CORE_UPGRADE_FAILED';if(snapshot&&changed){save('restoring',code);system(['/etc/init.d/gale-tunnel','stop'],8000);try{let restored_at=time();recover_core(snapshot);unlink('/tmp/gale-connection/health.json');if(snapshot.runtime.active){system(['/etc/init.d/gale-tunnel','start'],8000);if(!wait_health(json(snapshot.runtime.active).profile_id,restored_at))die('RESTORED_HTTPS_FAILED');}unlink('/etc/gale/core-upgrade.pending');if(coordinator)system(['/etc/init.d/gale-network','start'],5000);if(snapshot.runtime.active&&!wait_health(json(snapshot.runtime.active).profile_id,restored_at,snapshot.routing_required))die('RESTORED_LAN_FAILED');save('rolled_back',code);}catch(error){save('recovery_required','CORE_ROLLBACK_FAILED');}}else{if(snapshot)unlink('/etc/gale/core-upgrade.pending');save('failed',code);}}
