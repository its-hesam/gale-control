import {readfile,writefile,rename,symlink,unlink,chmod,stat,readlink} from 'fs';import {sha256} from 'digest';
let path='/etc/gale/releases.json',req=json(readfile(ARGV[1]=='--recovery-request'?'/etc/gale/recovery/transaction-request.json':'/dev/stdin')||'{}'),state;try{state=json(readfile(path)||'null');}catch(e){die('RELEASE_REGISTRY_CORRUPT');}
function valid_id(id){return type(id)=='string'&&!!match(id,/^[a-z0-9-]{1,80}$/);}
function verify(id,hash){if(!valid_id(id)||!match(hash||'',/^[a-f0-9]{64}$/))die('BAD_RELEASE_ID');let root='/usr/share/gale/releases/'+id,m=readfile(root+'/SHA256SUMS');if(!m||sha256(m)!=hash)die('RELEASE_MANIFEST_MISMATCH');if(system(['/bin/sh','-c','cd '+root+' && sha256sum -c SHA256SUMS >/dev/null 2>&1'],30000)!=0)die('RELEASE_FILES_MISMATCH');}
function save(){let body=sprintf('%J',state);if(writefile(path+'.new',body)!=length(body))die('RELEASE_REGISTRY_WRITE_FAILED');chmod(path+'.new',0o600);if(system(['/bin/sync'],5000)!=0)die('RELEASE_SYNC_FAILED');if(!rename(path+'.new',path))die('RELEASE_REGISTRY_COMMIT_FAILED');if(system(['/bin/sync'],5000)!=0)die('RELEASE_SYNC_FAILED');}
function point(id){let temp='/usr/share/gale/current.new';unlink(temp);if(!symlink('/usr/share/gale/releases/'+id,temp)||!rename(temp,'/usr/share/gale/current'))die('RELEASE_POINTER_COMMIT_FAILED');if(system(['/bin/sync'],5000)!=0)die('RELEASE_SYNC_FAILED');}
if(ARGV[0]=='initial'){if(state)die('RELEASE_REGISTRY_EXISTS');verify(req.id,req.manifest_hash);state={schema_version:1,current:req.id,previous:null,pending:null,manifests:{}};state.manifests[req.id]=req.manifest_hash;point(req.id);save();print({initialized:true,current:req.id});exit(0);}
if(!state)die('RELEASE_REGISTRY_MISSING');
if(ARGV[0]=='prepare'){if(state.pending)die('RELEASE_TRANSACTION_PENDING');verify(state.current,state.manifests[state.current]);verify(req.id,req.manifest_hash);state.manifests[req.id]=req.manifest_hash;state.pending={id:req.id,started_at:time()};save();point(req.id);print({prepared:true,current:state.current,candidate:req.id});exit(0);}
if(ARGV[0]=='commit'){if(req.id!=state.pending?.id)die('RELEASE_TRANSACTION_CHANGED');verify(req.id,state.manifests[req.id]);if(readlink('/usr/share/gale/current')!='/usr/share/gale/releases/'+req.id)die('RELEASE_POINTER_CHANGED');state.previous=state.current;state.current=req.id;state.pending=null;state.committed_at=time();save();print({committed:true,current:req.id,previous:state.previous});exit(0);}
die('UNKNOWN_RELEASE_OPERATION');
