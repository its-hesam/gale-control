// Stable early-boot recovery. No imports from a swappable application release.
import {readfile,writefile,rename,chmod,unlink,stat,mkdir} from 'fs';import {sha256} from 'digest';
let root='/etc/gale/recovery',raw=readfile(root+'/pending.json');if(!raw)exit(0);let pending=json(raw);if(pending.phase=='committed'){unlink(root+'/pending.json');system(['/bin/sync'],5000);print({completed_transaction:true});exit(0);}
let data=readfile(root+'/snapshot.json');if(!data||sha256(data)!=pending.snapshot_hash){data=readfile(root+'/snapshot.copy');if(!data||sha256(data)!=pending.snapshot_hash)die('RECOVERY_SNAPSHOT_CORRUPT');}let snapshot=json(data);
if(snapshot.encoding!='base64')die('RECOVERY_SNAPSHOT_ENCODING_REJECTED');
let allowed=[...map(['dropbear_ed25519_host_key','dropbear_rsa_host_key','dropbear_ecdsa_host_key','authorized_keys'],n=>'/etc/dropbear/'+n),...map(['network','firewall','wireless','dhcp','dropbear','uhttpd'],n=>'/etc/config/'+n),...map(['state.json','routing-draft.json','routing-active.json','network-options.json','discovery-options.json','cores.json','releases.json'],n=>'/etc/gale/'+n),...map(['active','binary','config.json','sidecars','sidecar-1.json','sidecar-2.json','binary-1','binary-2','pending'],n=>'/etc/gale/runtime/'+n),...map(['armed','draft.json','rules.nft','dns.json','tcp.json','binary-dns','binary-tcp','trial-mode','manifest.sha256'],n=>'/etc/gale/routing-test/'+n),...map(['armed','committed','dns.json','tcp.json','rules.nft','network-options.json','ra-default'],n=>'/etc/gale/ipv6-before/'+n),'/usr/share/nftables.d/chain-pre/forward/40-gale-guard.nft','/usr/share/nftables.d/chain-pre/input/40-gale-guard.nft'];
function parents(path){let current='';for(let p in slice(split(path,'/'),1,-1)){current+='/'+p;if(!stat(current))mkdir(current,0o700);}}
for(let path in keys(snapshot.files))if(!(path in allowed))die('RECOVERY_SNAPSHOT_PATH_REJECTED');for(let path in allowed){let value=snapshot.files[path];if(value==null){unlink(path);continue;}if(type(value.data)!='string'||type(value.mode)!='int')die('RECOVERY_SNAPSHOT_FORMAT_REJECTED');let data=b64dec(value.data);if(type(data)!='string')die('RECOVERY_FILE_ENCODING_REJECTED');parents(path);if(writefile(path+'.recover',data)!=length(data))die('RECOVERY_FILE_WRITE_FAILED');chmod(path+'.recover',value.mode&0o777);if(!rename(path+'.recover',path))die('RECOVERY_FILE_COMMIT_FAILED');}
if(stat('/usr/share/gale-release-recover.uc')&&system(['/usr/bin/ucode','/usr/share/gale-release-recover.uc'],35000)!=0)die('RECOVERY_CODE_POINTER_FAILED');
if(snapshot.gale_scheduler===true)system(['/usr/share/gale/current/helpers/install-scheduler'],5000);else if(stat('/usr/share/gale/current/helpers/scheduler-remove'))system(['/usr/share/gale/current/helpers/scheduler-remove'],5000);
for(let name in ['gale-tunnel','gale-network','gale-route-watch','gale-monitor'])if(type(snapshot.init_flags?.[name])=='bool')system(['/etc/init.d/'+name,snapshot.init_flags[name]?'enable':'disable'],3000);
system(['/bin/sync'],5000);unlink(root+'/pending.json');system(['/bin/sync'],5000);print({snapshot_restored:true,network_services_restarted:false});
