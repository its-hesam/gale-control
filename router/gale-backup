#!/usr/bin/ucode
import {readfile,writefile,rename,chmod,open,stat,unlink,mkdir,popen} from 'fs';
import {sha256} from 'digest';
import {load_store,lock_store,save_store} from '/usr/share/gale/lib/store.uc';
import {export_recovery,inspect_recovery,recovery_key} from '/usr/share/gale/lib/recovery.uc';
import {restore_catalog} from '/usr/share/gale/lib/backup.uc';
if(ARGV[0]=='list'){print({status:{},export_full:{},export_key:{},import_key:{content:'String'},restore_full:{revision:'String',confirmed:'Boolean'},confirm_full:{id:'String'},cancel_full:{id:'String'},export:{},preview:{content:'String'},upload_begin:{bytes:'Integer',target:'String'},upload_chunk:{token:'String',offset:'Integer',data:'String'},upload_finish:{token:'String'},restore:{revision:'String',confirmed:'Boolean'}});exit(0);}if(ARGV[0]!='call')exit(1);
try{
 if(ARGV[1]=='status'){let job=null;try{job=json(readfile('/tmp/gale-full-restore/job.json')||readfile('/etc/gale/recovery/last-result.json')||'null');}catch(e){}print({schema_version:1,job:job,recovery_pending:!!stat('/etc/gale/recovery/pending.json'),key_available:!!stat('/etc/gale/recovery-signing.key')});exit(0);}
 if(ARGV[1]=='export_full'){if(stat('/etc/gale/recovery/pending.json')||stat('/etc/gale/core-upgrade.pending'))die('SYSTEM_RECOVERY_RUNNING');let code_lock=open('/etc/gale/release.lock','a',0o600),core_lock=open('/etc/gale/core-upgrade.lock','a',0o600),connection_lock=open('/tmp/gale-connection/control.lock','a',0o600);if(!code_lock||!code_lock.lock('xn')||!core_lock||!core_lock.lock('xn')||!connection_lock||!connection_lock.lock('xn'))die('BACKUP_BUSY');let store_lock=lock_store();print({schema_version:1,content:export_recovery(),contains_secrets:true,scope:'signed_full_Gale_recovery'});exit(0);}
 if(ARGV[1]=='export_key'){print({schema_version:1,content:b64enc(recovery_key(true)),contains_secrets:true});exit(0);}
 if(ARGV[1]=='export'){let lock=lock_store();print({schema_version:1,content:sprintf('%J',{format:'gale-catalog',version:1,created_at:time(),store:load_store()}),contains_secrets:true,scope:'profiles_sources_security_only'});exit(0);}
 let req=json(readfile('/dev/stdin')||'{}');
 if(ARGV[1] in ['confirm_full','cancel_full']){let job=json(readfile('/tmp/gale-full-restore/job.json')||'null');if(!job||req.id!=job.id)die('RECOVERY_JOB_CHANGED');if(ARGV[1]=='confirm_full'){if(job.state!='awaiting_client_confirmation'||time()>job.confirm_before)die('RECOVERY_NOT_AWAITING_CONFIRMATION');writefile('/tmp/gale-full-restore/confirm',req.id);print({schema_version:1,confirmation_received:true});}else{writefile('/tmp/gale-full-restore/cancel',req.id);print({schema_version:1,cancellation_requested:true});}exit(0);}
 let stage_lock=open('/etc/gale/restore-stage.lock','a',0o600);if(!stage_lock||!stage_lock.lock('xn'))die('BACKUP_BUSY');
 if(stat('/etc/gale/recovery/pending.json'))die('SYSTEM_RECOVERY_RUNNING');
 if(ARGV[1]=='import_key'){let key=b64dec(trim(req.content||''));if(type(key)!='string'||length(key)!=32)die('BAD_RECOVERY_KEY');if(stat('/etc/gale/recovery-signing.key'))die('RECOVERY_KEY_ALREADY_INSTALLED');if(writefile('/etc/gale/recovery-signing.key.new',key)!=32)die('RECOVERY_KEY_WRITE_FAILED');chmod('/etc/gale/recovery-signing.key.new',0o600);if(!rename('/etc/gale/recovery-signing.key.new','/etc/gale/recovery-signing.key'))die('RECOVERY_KEY_COMMIT_FAILED');system(['/bin/sync'],5000);print({schema_version:1,key_installed:true});exit(0);}
 if(ARGV[1]=='restore_full'){
  if(req.confirmed!==true)die('FULL_RECOVERY_CONFIRMATION_REQUIRED');let raw=readfile('/etc/gale/restore-full.json');if(!raw||req.revision!=sha256(raw))die('RECOVERY_PREVIEW_CHANGED');if(stat('/etc/gale/core-upgrade.pending'))die('CORE_UPGRADE_RUNNING');let registry=json(readfile('/etc/gale/releases.json')||'null');if(!registry||registry.pending)die('CODE_UPDATE_PENDING');
  for(let item in [{path:'/tmp/gale-batch/job.json',states:['queued','running']},{path:'/tmp/gale-discovery/job.json',states:['queued','sources','validating','probing']}]){let job;try{job=json(readfile(item.path)||'null');}catch(e){}if(job?.state in item.states&&time()-job.updated_at<120)die('BACKGROUND_JOB_RUNNING');}
  for(let dir in ['/etc/gale/recovery','/tmp/gale-full-restore']){if(!stat(dir))mkdir(dir);chmod(dir,0o700);}let control=open('/tmp/gale-full-restore/queue.lock','a',0o600);if(!control||!control.lock('xn'))die('RECOVERY_BUSY');let previous;try{previous=json(readfile('/tmp/gale-full-restore/job.json')||'null');}catch(e){}if(previous?.state in ['queued','preparing','applying','validating','reloading_network','reconnecting','awaiting_client_confirmation','rolling_back'])die('RECOVERY_BUSY');
  let id=substr(sha256(readfile('/proc/sys/kernel/random/uuid')+time()),0,24);writefile('/tmp/gale-full-restore/request.json',sprintf('%J',{id:id,revision:req.revision}));chmod('/tmp/gale-full-restore/request.json',0o600);writefile('/tmp/gale-full-restore/job.json',sprintf('%J',{id:id,state:'queued',updated_at:time()}));chmod('/tmp/gale-full-restore/job.json',0o600);unlink('/tmp/gale-full-restore/confirm');unlink('/tmp/gale-full-restore/cancel');control.close();stage_lock.close();let child=popen('/usr/share/gale/recovery-launch','r');if(!child||child.close()!=0)die('RECOVERY_LAUNCH_FAILED');print({schema_version:1,id:id,state:'queued'});exit(0);
 }
 if(ARGV[1]=='upload_begin'){let target=req.target||'backup';if(!(target in ['backup','profiles']))die('BAD_UPLOAD_TARGET');if(target=='profiles'&&req.bytes>1048576)die('PROFILE_UPLOAD_LIMIT');if(type(req.bytes)!='int'||req.bytes<1||req.bytes>8388608)die('BACKUP_LIMIT');let token=replace(trim(readfile('/proc/sys/kernel/random/uuid')),'-','');let f=open('/tmp/gale-backup-upload.part','w',0o600);if(!f)die('BACKUP_STAGE_FAILED');f.close();chmod('/tmp/gale-backup-upload.part',0o600);writefile('/tmp/gale-backup-upload.meta',sprintf('%J',{token:token,target:target,bytes:req.bytes,at:time()}));chmod('/tmp/gale-backup-upload.meta',0o600);print({schema_version:1,token:token,chunk_bytes:12288});exit(0);}
 if(ARGV[1] in ['upload_chunk','upload_finish']){let meta;try{meta=json(readfile('/tmp/gale-backup-upload.meta')||'null');}catch(e){}if(!meta||req.token!=meta.token||time()-meta.at>900)die('BACKUP_UPLOAD_EXPIRED');let size=stat('/tmp/gale-backup-upload.part')?.size||0;
  if(ARGV[1]=='upload_chunk'){if(req.offset!=size||type(req.data)!='string'||length(req.data)>16384)die('BAD_BACKUP_CHUNK');let data=b64dec(req.data);if(type(data)!='string'||length(data)<1||length(data)>12288||size+length(data)>meta.bytes)die('BAD_BACKUP_CHUNK');let f=open('/tmp/gale-backup-upload.part','a',0o600);if(!f||f.write(data)!=length(data))die('BACKUP_STAGE_FAILED');f.close();print({schema_version:1,offset:size+length(data)});exit(0);}
  if((meta.target||'backup')!='backup')die('BAD_UPLOAD_TARGET');if(size!=meta.bytes)die('BACKUP_UPLOAD_INCOMPLETE');req.content=readfile('/tmp/gale-backup-upload.part');unlink('/tmp/gale-backup-upload.part');unlink('/tmp/gale-backup-upload.meta');
 }

 if(ARGV[1] in ['preview','upload_finish']){if(type(req.content)!='string'||length(req.content)>8388608)die('BACKUP_LIMIT');let b;try{b=json(req.content);}catch(e){die('BAD_BACKUP_JSON');}if(b.format=='gale-recovery'){let full=inspect_recovery(req.content);writefile('/etc/gale/restore-full.new',req.content);chmod('/etc/gale/restore-full.new',0o600);if(!rename('/etc/gale/restore-full.new','/etc/gale/restore-full.json'))die('RECOVERY_PREVIEW_FAILED');print({schema_version:1,kind:'full',revision:sha256(req.content),...full.summary});exit(0);}let normalized=restore_catalog(b),text=sprintf('%J',normalized);writefile('/etc/gale/restore-preview.new',text);chmod('/etc/gale/restore-preview.new',0o600);if(!rename('/etc/gale/restore-preview.new','/etc/gale/restore-preview.json'))die('BACKUP_STAGE_FAILED');print({schema_version:1,revision:sha256(text),profiles:length(keys(normalized.profiles)),sources:length(keys(normalized.sources)),all_disabled:true,scope:'profiles_sources_security_only',network_settings_restored:false});exit(0);}
 if(ARGV[1]=='restore'){
  if(req.confirmed!==true)die('RESTORE_CONFIRMATION_REQUIRED');let control=open('/tmp/gale-connection/control.lock','a',0o600);if(!control||!control.lock('xn'))die('CONNECTION_BUSY');
  if(stat('/etc/gale/runtime/active')||stat('/etc/gale/routing-test/armed')||stat('/etc/gale/core-upgrade.pending'))die('DISCONNECT_BEFORE_CATALOG_RESTORE');
  let lock=lock_store(),text=readfile('/etc/gale/restore-preview.json');if(!text||req.revision!=sha256(text))die('BACKUP_PREVIEW_CHANGED');let old=sprintf('%J',load_store());if(!writefile('/etc/gale/state.before-restore.json',old))die('BACKUP_SNAPSHOT_FAILED');chmod('/etc/gale/state.before-restore.json',0o600);save_store(json(text));unlink('/etc/gale/restore-preview.json');print({schema_version:1,restored:true,network_changed:false,validation_required:true});exit(0);
 }
 die('UNKNOWN_METHOD');
}catch(e){print({schema_version:1,error:match(e.message||'',/^[A-Z0-9_]+$/)?e.message:'BACKUP_OPERATION_FAILED'});}
