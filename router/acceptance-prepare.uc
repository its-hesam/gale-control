import {readfile,writefile,chmod,mkdir,stat} from 'fs';import {load_store} from '/usr/share/gale/lib/store.uc';import {connection_config} from '/usr/share/gale/lib/connection.uc';import {balanced_dispatcher} from '/usr/share/gale/lib/balancing.uc';import {core_path} from '/usr/share/gale/lib/cores.uc';import {public_ipv4} from '/usr/share/gale/lib/sources.uc';
let root='/etc/gale/acceptance-stage';if(stat(root+'/armed'))die('ACCEPTANCE_ALREADY_RUNNING');if(!stat(root))mkdir(root);chmod(root,0o700);if(!stat(root+'/runtime'))mkdir(root+'/runtime');chmod(root+'/runtime',0o700);
let s=load_store(),active=json(readfile('/etc/gale/runtime/active')),backup=filter(values(s.profiles),p=>p.id!=active.profile_id&&p.native_status=='passed'&&p.model.protocol=='vmess'&&p.last_test?.ok&&time()-p.last_test.tested_at<900)[0];if(!backup)die('FRESH_BACKUP_REQUIRED');
let a=connection_config(s.profiles[active.profile_id],s.security),b=connection_config(backup,s.security),out=a.config.outbounds[0],ip=out.server||out.settings?.vnext?.[0]?.address,port=out.server_port||out.settings?.vnext?.[0]?.port;if(!public_ipv4(ip)||type(port)!='int')die('PRIMARY_IPV4_REQUIRED');let other=b.config.outbounds[0],backup_ip=other.server||other.settings?.vnext?.[0]?.address;if(backup_ip==ip)die('SEPARATE_BACKUP_ENDPOINT_REQUIRED');
let mem=match(readfile('/proc/meminfo'),/MemAvailable:\s*([0-9]+)/);if(!mem||+mem[1]<229376)die('ACCEPTANCE_RAM_BUDGET');
writefile(root+'/request.json',sprintf('%J',{primary:active.profile_id,backup:backup.id,original:active}));chmod(root+'/request.json',0o600);
writefile(root+'/block.nft','table inet gale_acceptance {\n chain output {\n type filter hook output priority -2; policy accept; ip daddr '+ip+' tcp dport '+port+' counter drop;\n }\n}\n');chmod(root+'/block.nft',0o600);
if(system(['/usr/sbin/nft','-c','-f',root+'/block.nft'],5000)!=0)die('ACCEPTANCE_BLOCK_SCHEMA_REJECTED');
writefile(root+'/balanced.json',sprintf('%J',balanced_dispatcher(2)));chmod(root+'/balanced.json',0o600);if(system(['/usr/share/gale/capture',root+'/native-output',core_path('xray'),'run','-test','-c',root+'/balanced.json'],5000)!=0)die('ACCEPTANCE_BALANCER_REJECTED');
print({prepared:true,scope:'best_failover_balanced_all_LAN',members:2,network_changed:false,independent_restore_seconds:300});
