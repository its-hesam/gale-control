#!/bin/sh /etc/rc.common
START=99
STOP=8
USE_PROCD=1
start_service() {
 procd_open_instance indicator
 procd_set_param command /usr/bin/ucode /usr/share/gale/led-worker.uc
 procd_set_param respawn 3600 2 3
 procd_close_instance
}
stop_service() {
 /usr/bin/ucode -e 'import {led_restore} from "/usr/share/gale/lib/leds.uc";led_restore();'
 rm -f /tmp/gale-led-applied
}
