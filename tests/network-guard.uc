import {network_guard_rules} from '/usr/share/gale/lib/network-guard.uc';import {mkdtemp,writefile,unlink,rmdir} from 'fs';let rules=network_guard_rules(),dir=mkdtemp('/tmp/gale-guard-check-XXXXXX');writefile(dir+'/rules.nft','table inet gale_guard_schema {\n chain forward {\n'+rules.forward+' }\n chain input {\n'+rules.input+' }\n}\n');let code=system(['/usr/sbin/nft','-c','-f',dir+'/rules.nft'],5000);unlink(dir+'/rules.nft');rmdir(dir);assert(code==0,'persistent guard kernel dry run failed');assert(index(rules.input,'th dport 53')>=0,'DNS fallback guard absent');assert(index(rules.forward,'192.168.0.0/16')>=0,'local management exception absent');print({passed:3,kernel_dry_run:true,applied:false});
