import {public_ipv6} from '/usr/share/gale/lib/addresses.uc';let valid=['2606:4700:4700::1111','2001:4860:4860::8888','2a00:1450:4001::1'],invalid=['::','::1','fc00::1','fe80::1','ff02::1','::ffff:192.168.10.1','2001:db8::1','2001:0::1','2002:c0a8:0a01::1','2001::1::2','2001:::1','2001:4860:1234'];for(let ip in valid)assert(public_ipv6(ip),'public IPv6 rejected');for(let ip in invalid)assert(!public_ipv6(ip),'nonpublic IPv6 accepted');print({passed:length(valid)+length(invalid),network_changed:false});
