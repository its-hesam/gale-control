import {extract_profiles} from '/usr/share/gale/lib/profiles.uc';import {validate_core} from '/usr/share/gale/lib/adapter.uc';
let yaml='proxies:\n  - name: "Clash VMess"\n    type: vmess\n    server: 203.0.113.1\n    port: 443\n    uuid: 00000000-0000-4000-8000-000000000001\n    alterId: 0\n    cipher: auto\n    tls: true\n    servername: example.com\n    skip-cert-verify: false\n    network: ws\n    ws-opts:\n      path: /fixture\n      headers:\n        Host: example.com\n';
let result=extract_profiles(yaml);assert(length(result.profiles)==1&&!length(result.errors),'YAML import failed');assert(result.profiles[0].model.parameters.host=='example.com','WS authority lost');assert(validate_core(result.profiles[0]).passed,'Clash model native rejected');
let native={outbounds:[{tag:'native-fixture',protocol:'vmess',settings:{vnext:[{address:'203.0.113.1',port:443,users:[{id:'00000000-0000-4000-8000-000000000001',security:'auto'}]}]},streamSettings:{network:'ws',security:'tls',tlsSettings:{serverName:'example.com',allowInsecure:false},wsSettings:{path:'/fixture',headers:{Host:'example.com'}}}}]};
let n=extract_profiles(sprintf('%J',native));assert(length(n.profiles)==1&&!length(n.errors),'native extraction failed');assert(validate_core(n.profiles[0]).passed,'native Xray config rejected');
let unsafe=json(sprintf('%J',native));unsafe.outbounds[0].streamSettings.tlsSettings.masterKeyLog='/tmp/unsafe';assert(length(extract_profiles(sprintf('%J',unsafe)).errors)==1,'native file write accepted');
let bad=replace(yaml,'    cipher: auto','    cipher: auto\n    unknown-execution-option: true');assert(length(extract_profiles(bad).errors)==1,'unknown Clash option dropped');
let alias='proxies: &root\n  - name: cycle\n    type: vmess\n    loop: *root\n';let rejected=false;try{extract_profiles(alias);}catch(e){rejected=true;}assert(rejected,'cyclic YAML alias accepted');
print({passed:7,yaml_parser:'lyaml',native_schemas_checked:true,network_changed:false,openvpn_provider_tested:false});
