import {readfile,writefile,mkdir,chmod} from 'fs';import {load_store} from '/usr/share/gale/lib/store.uc';import {connection_config} from '/usr/share/gale/lib/connection.uc';let store=load_store(),out=[],n=0;mkdir('/tmp/gale-v6-candidates');chmod('/tmp/gale-v6-candidates',0o700);for(let id,p in store.profiles){if(p.model.protocol!='vmess'||n>=4)continue;try{let s=connection_config(p,store.security_policy);s.config.inbounds=s.core=='xray'?[{tag:'probe',listen:'127.0.0.1',port:18501,protocol:'socks',settings:{auth:'noauth',udp:true}}]:[{type:'socks',listen:'127.0.0.1',listen_port:18501}];writefile('/tmp/gale-v6-candidates/'+n+'.json',sprintf('%J',s.config));chmod('/tmp/gale-v6-candidates/'+n+'.json',0o600);writefile('/tmp/gale-v6-candidates/'+n+'.bin',s.binary+'\n');push(out,{index:n,id:id,protocol:p.model.protocol});n++;}catch(e){}}writefile('/tmp/gale-v6-candidates/index.json',sprintf('%J',out));print({prepared:n});
