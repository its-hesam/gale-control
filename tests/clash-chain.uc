import {extract_profiles} from '/usr/share/gale/lib/profiles.uc';import {validate_core,core_config} from '/usr/share/gale/lib/adapter.uc';let source={gale_clash_root:'outer',proxies:[{name:'outer',type:'http',server:'127.0.0.1',port:18101,'dialer-proxy':'inner'},{name:'inner',type:'socks5',server:'127.0.0.1',port:18102}]},r=extract_profiles(sprintf('%J',source));assert(length(r.profiles)==1&&!length(r.errors),'CLASH_CHAIN_IMPORT_FAILED');let p=r.profiles[0];assert(validate_core(p).passed,'CLASH_CHAIN_NATIVE_FAILED');assert(core_config(p).config.outbounds[0].streamSettings.sockopt.dialerProxy=='gale-chain-1','CLASH_CHAIN_REFERENCE_LOST');assert(extract_profiles(p.original).profiles[0].id==p.id,'CLASH_CHAIN_ROUNDTRIP_FAILED');source.proxies[1]['dialer-proxy']='outer';assert(length(extract_profiles(sprintf('%J',source)).errors)>0,'CLASH_CYCLE_ACCEPTED');print({passed:5,clash_dialer_proxy:true,mixed_core_chains:false});
