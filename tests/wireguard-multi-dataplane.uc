import {readfile,writefile} from 'fs';import {parse_profile} from '/usr/share/gale/lib/profiles.uc';import {core_config} from '/usr/share/gale/lib/adapter.uc';import {core_path} from '/usr/share/gale/lib/cores.uc';let d=ARGV[0],raw='[Interface]\nPrivateKey = '+trim(readfile(d+'/client.key'))+'\nAddress = 10.253.0.2/32\nDNS = 1.1.1.1\n';for(let n in [1,2]){raw+='[Peer]\nPublicKey = '+trim(readfile(d+'/peer'+n+'.pub'))+'\nEndpoint = 127.0.0.1:'+ (18400+n)+'\nAllowedIPs = 10.253.'+n+'.1/32\n';}let s=core_config(parse_profile(raw));s.config.inbounds=[{type:'socks',listen:'127.0.0.1',listen_port:18400}];writefile(d+'/client.json',sprintf('%J',s.config));writefile(d+'/binary',core_path('sing-box')+'\n');
