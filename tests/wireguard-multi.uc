import {parse_profile} from '/usr/share/gale/lib/profiles.uc';import {core_config,validate_core} from '/usr/share/gale/lib/adapter.uc';
let raw='[Interface]\nPrivateKey = AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAE=\nAddress = 10.66.0.2/32\nDNS = 1.1.1.1,8.8.8.8\n[Peer]\nPublicKey = AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAI=\nEndpoint = one.example.com:51820\nAllowedIPs = 0.0.0.0/1\n[Peer]\nPublicKey = AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAM=\nEndpoint = two.example.com:51820\nAllowedIPs = 128.0.0.0/1\n';let p=parse_profile(raw),s=core_config(p);assert(length(s.config.endpoints[0].peers)==2,'SECOND_PEER_LOST');assert(s.config.endpoints[0].peers[1].address=='two.example.com','SECOND_ENDPOINT_LOST');assert(s.dns_policy=='ordered_timeout_failover','DNS_FAILOVER_NOT_ENABLED');assert(validate_core(p).passed,'MULTI_PEER_NATIVE_REJECTED');let duplicate=false;try{core_config(parse_profile(replace(raw,'128.0.0.0/1','0.0.0.0/1')));}catch(e){duplicate=true;}assert(duplicate,'AMBIGUOUS_PEER_PREFIX_ACCEPTED');print({passed:5,peers:2,native_schema:true,provider_tested:false,network_changed:false});
