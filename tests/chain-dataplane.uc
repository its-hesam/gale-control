import {extract_profiles} from '/usr/share/gale/lib/profiles.uc';import {core_config} from '/usr/share/gale/lib/adapter.uc';import {core_path} from '/usr/share/gale/lib/cores.uc';import {writefile} from 'fs';
let root={gale_root:'outer',outbounds:[{type:'http',tag:'outer',server:'127.0.0.1',server_port:18101,detour:'inner'},{type:'socks',tag:'inner',server:'127.0.0.1',server_port:18102,version:'5'}]},p=extract_profiles(sprintf('%J',root)).profiles[0],s=core_config(p);s.config.inbounds=[{type:'socks',listen:'127.0.0.1',listen_port:18100}];s.config.dns={servers:[{tag:'resolver',type:'udp',server:'1.1.1.1'}]};s.config.route.default_domain_resolver='resolver';
writefile(ARGV[0]+'/client.json',sprintf('%J',s.config));writefile(ARGV[0]+'/binary',core_path('sing-box')+'\n');
let clash={gale_clash_root:'outer',proxies:[{name:'outer',type:'http',server:'127.0.0.1',port:18101,'dialer-proxy':'inner'},{name:'inner',type:'socks5',server:'127.0.0.1',port:18102}]},cp=extract_profiles(sprintf('%J',clash)).profiles[0],cs=core_config(cp);cs.config.inbounds=[{tag:'probe',listen:'127.0.0.1',port:18100,protocol:'socks',settings:{auth:'noauth'}}];writefile(ARGV[0]+'/clash-client.json',sprintf('%J',cs.config));writefile(ARGV[0]+'/clash-binary',(cs.binary||core_path(cs.core))+'\n');
let server={log:{disabled:true},dns:{servers:[{tag:'resolver',type:'udp',server:'1.1.1.1'}]},inbounds:[{type:'http',tag:'outer',listen:'127.0.0.1',listen_port:18101},{type:'socks',tag:'inner',listen:'127.0.0.1',listen_port:18102}],outbounds:[{type:'direct',tag:'direct'}],route:{final:'direct',default_domain_resolver:'resolver'}};writefile(ARGV[0]+'/server.json',sprintf('%J',server));
