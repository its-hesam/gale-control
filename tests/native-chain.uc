import {extract_profiles} from '/usr/share/gale/lib/profiles.uc';import {core_config,validate_core} from '/usr/share/gale/lib/adapter.uc';
let source={gale_root:'outer',outbounds:[{type:'http',tag:'outer',server:'203.0.113.1',server_port:8080,detour:'inner'},{type:'socks',tag:'inner',server:'203.0.113.2',server_port:1080,version:'5'}]},r=extract_profiles(sprintf('%J',source));assert(length(r.profiles)==1&&!length(r.errors),'CHAIN_IMPORT_FAILED');let p=r.profiles[0],config=core_config(p).config;assert(length(config.outbounds)==2&&config.outbounds[0].detour=='gale-chain-1','CHAIN_REFERENCE_LOST');assert(validate_core(p).passed,'CHAIN_NATIVE_REJECTED');assert(extract_profiles(p.original).profiles[0].id==p.id,'CHAIN_BACKUP_ID_CHANGED');
let cycle=json(sprintf('%J',source));cycle.outbounds[1].detour='outer';assert(length(extract_profiles(sprintf('%J',cycle)).errors)>0,'CHAIN_CYCLE_ACCEPTED');let missing=json(sprintf('%J',source));missing.outbounds[0].detour='absent';assert(length(extract_profiles(sprintf('%J',missing)).errors)>0,'MISSING_CHAIN_ACCEPTED');
let x={gale_root:'outer',outbounds:[{protocol:'http',tag:'outer',settings:{servers:[{address:'203.0.113.1',port:8080}]},proxySettings:{tag:'inner'}},{protocol:'socks',tag:'inner',settings:{servers:[{address:'203.0.113.2',port:1080}]}}]},xr=extract_profiles(sprintf('%J',x));assert(length(xr.profiles)==1&&validate_core(xr.profiles[0]).passed,'XRAY_CHAIN_NATIVE_REJECTED');
print({passed:7,sing_box_detour:true,xray_proxy_settings:true,cycles_rejected:true,provider_tested:false,network_changed:false});
